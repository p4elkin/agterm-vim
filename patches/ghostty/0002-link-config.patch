+
+/// Compare two actions by VALUE. `std.meta.eql` compares a slice payload by
+/// pointer, so two templates with identical text would read as different and
+/// a config reload would look like a change every time.
+fn actionEqual(a: Action, b: Action) bool {
+    if (std.meta.activeTag(a) != std.meta.activeTag(b)) return false;
+    return switch (a) {
+        .open_template => |t| std.mem.eql(u8, t, b.open_template),
+        else => true,
+    };
