+test "link: open action" {
+    const testing = std.testing;
+    var cfg = try Config.default(testing.allocator);
+    defer cfg.deinit();
+    const alloc = cfg._arena.?.allocator();
+
+    // A default link (the built-in URL one) already exists.
+    const before = cfg.link.links.items.len;
