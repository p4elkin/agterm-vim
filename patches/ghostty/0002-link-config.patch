diff --git a/src/input/Link.zig b/src/input/Link.zig
index 37b45db..2bf3c82 100644
--- a/src/input/Link.zig
+++ b/src/input/Link.zig
@@ -26,11 +26,41 @@ pub const Action = union(enum) {
     /// For example, on macOS this is "open" and on Linux this is "xdg-open".
     open: void,
 
+    /// Open a URL built from a template, with `$0` replaced by the full
+    /// matched value. Lets a match that is not itself a URL -- an id, a
+    /// bare path -- resolve to one. The template is owned by the same
+    /// allocator as `regex`.
+    open_template: []const u8,
+
     /// Open the OSC8 hyperlink under the mouse position. _-prefixed means
     /// this can't be user-specified, it's only used internally.
     _open_osc8: void,
 };
 
+/// Expand an `open_template` against a matched value. Caller owns the result.
+/// Only `$0` is substituted, and it is substituted verbatim: the regex the
+/// user wrote is the boundary on what can appear here, exactly as it already
+/// is for a plain `open`, which hands the raw match to the system opener.
+pub fn expandTemplate(
+    alloc: Allocator,
+    template: []const u8,
+    match: []const u8,
+) Allocator.Error![:0]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(alloc);
+    var i: usize = 0;
+    while (i < template.len) {
+        if (i + 1 < template.len and template[i] == '$' and template[i + 1] == '0') {
+            try out.appendSlice(alloc, match);
+            i += 2;
+            continue;
+        }
+        try out.append(alloc, template[i]);
+        i += 1;
+    }
+    return try out.toOwnedSliceSentinel(alloc, 0);
+}
