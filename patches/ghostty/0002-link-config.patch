+            return;
+        }
+
+        const comma = std.mem.indexOfScalar(u8, value, ',') orelse
+            return error.InvalidValue;
+        const action_raw = std.mem.trim(u8, value[0..comma], " \t");
+        const regex = value[comma + 1 ..];
+        if (regex.len == 0) return error.InvalidValue;
