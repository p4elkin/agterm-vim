+
+    const before = cfg.link.links.items.len;
+    try cfg.link.parseCLI(alloc, "open:file:///tmp/$0.md,msg-\\d{6}");
+
+    const link = cfg.link.links.items[before];
+    try testing.expect(link.action == .open_template);
+    try testing.expectEqualStrings("file:///tmp/$0.md", link.action.open_template);
+    try testing.expectEqualStrings("msg-\\d{6}", link.regex);
+}
+
+test "link: the split is the FIRST comma, so a regex may contain one" {
+    const testing = std.testing;
+    var cfg = try Config.default(testing.allocator);
+    defer cfg.deinit();
+    const alloc = cfg._arena.?.allocator();
+
+    // This is the whole reason the action comes first. A regex quantifier
+    // like {2,4} holds a comma; splitting on the last comma would cut here.
+    const before = cfg.link.links.items.len;
+    try cfg.link.parseCLI(alloc, "open,ab\\d{2,4}cd");
+
+    const link = cfg.link.links.items[before];
+    try testing.expect(link.action == .open);
+    try testing.expectEqualStrings("ab\\d{2,4}cd", link.regex);
+}
+
+test "link: rejects what is not user-specifiable" {
+    const testing = std.testing;
