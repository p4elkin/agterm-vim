diff --git a/src/renderer/Thread.zig b/src/renderer/Thread.zig
index 5087213..0c5f281 100644
--- a/src/renderer/Thread.zig
+++ b/src/renderer/Thread.zig
@@ -107,6 +107,12 @@ flags: packed struct {
     /// This is true when the view is focused. This defaults to true
     /// and it is up to the apprt to set the correct value.
     focused: bool = true,
+
+    /// Whether the renderer currently holds its GPU resources. False only
+    /// between an unrealize and the matching realize. Drawing is skipped
+    /// while false: the swap chain is defunct and would reject the frame
+    /// anyway, this just avoids the error round trip on every draw request.
+    realized: bool = true,
 } = .{},
 
 pub const DerivedConfig = struct {
@@ -376,6 +382,35 @@ fn drainMailbox(self: *Thread) !void {
                 // check the visible state themselves to control their behavior.
             },
 
+            .realized => |v| realized: {
+                // If our state didn't change we do nothing. This also makes
+                // an unpaired message harmless rather than tripping the
+                // defunct assert in displayRealized.
+                if (self.flags.realized == v) break :realized;
+
+                if (v) {
+                    self.renderer.displayRealized() catch |err| {
+                        // We keep the flag false so a later realize can retry.
+                        // Leaving it true would let draws through to a swap
+                        // chain that was never rebuilt.
+                        log.warn("error realizing renderer err={}", .{err});
+                        break :realized;
+                    };
+                    self.flags.realized = true;
+                    // The rebuilt swap chain's targets hold nothing, so the
+                    // next frame must repaint everything rather than the cells
+                    // the terminal happens to consider dirty. A quiet surface
+                    // dirties nothing at all, and one resized while unrealized
+                    // dirties only part, which paints the new target at the old
+                    // geometry and leaves the rest blank until a keystroke.
+                    self.renderer.markDirty();
+                    self.drawFrame(false);
+                } else {
+                    self.flags.realized = false;
+                    self.renderer.displayUnrealized();
+                }
+            },
+
             .focus => |v| focus: {
                 // If our state didn't change we do nothing.
                 if (self.flags.focused == v) break :focus;
@@ -495,6 +530,9 @@ fn drawFrame(self: *Thread, now: bool) void {
     // If we're invisible, we do not draw.
     if (!self.flags.visible) return;
 
+    // If we hold no GPU resources there is nothing to draw into.
+    if (!self.flags.realized) return;
+
     // If the renderer is managing a vsync on its own, we only draw
     // when we're forced to via `now`.
     if (!now and self.renderer.hasVsync()) return;
