diff --git a/src/Surface.zig b/src/Surface.zig
index 5d16f33..a879fa2 100644
--- a/src/Surface.zig
+++ b/src/Surface.zig
@@ -3279,6 +3279,24 @@ pub fn occlusionCallback(self: *Surface, visible: bool) !void {
     try self.queueRender();
 }
 
+/// Callback for whether this surface should hold GPU resources at all.
+///
+/// Stronger than `occlusionCallback`: that one pauses drawing, this one
+/// releases the swap chain and shaders so a surface hidden indefinitely
+/// costs no GPU memory. The terminal state and the shell are untouched, so
+/// output keeps being processed while unrealized and the first frame after
+/// realizing shows it. See the `realized` message for the pairing rule.
+pub fn realizedCallback(self: *Surface, realized: bool) !void {
+    // Crash metadata in case we crash in here
+    crash.sentry.thread_state = self.crashThreadState();
+    defer crash.sentry.thread_state = null;
+
+    _ = self.renderer_thread.mailbox.push(global.io(), .{
+        .realized = realized,
+    }, .{ .forever = {} });
+    try self.queueRender();
+}
+
 pub fn focusCallback(self: *Surface, focused: bool) !void {
     // Crash metadata in case we crash in here
     crash.sentry.thread_state = self.crashThreadState();
